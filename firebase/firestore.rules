// Règles de sécurité Firestore — Mission Aquapolis
// À copier-coller dans : console Firebase > Firestore Database > Règles > Publier
//
// Logique :
//  - config/* et teams/* (le contenu du jeu) : lecture libre, écriture réservée
//    au compte admin connecté (Authentication > Email/Password).
//  - gameState/* (la progression envoyée par les 5 téléphones) : lecture et
//    écriture libres, mais uniquement sur les 5 documents attendus. Ce choix
//    évite d'imposer une connexion aux chefs de brigade pendant le jeu ; le
//    risque est jugé acceptable pour un événement d'une journée avec un lien
//    diffusé à un public restreint.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /teams/{color} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gameState/{color} {
      allow read: if true;
      allow write: if color in ['bleu', 'rouge', 'jaune', 'vert', 'violet'];
    }
  }
}
